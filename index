function setVar(el,v){el.style.setProperty('--i',v.toFixed(3));}

/* ---------------- state text ---------------- */
function ctlState(t,res){
  var a=activeCam(t);
  if(a)return ['Trigger CAM '+a+' + '+LIGHT[a],'light on, shutter open'];
  if(t<2)return ['Belt: part coming in','A side up'];
  if(t<CAP1A)return ['Part at Station 1','waiting until still'];
  if(t<3.3)return ['Station 1 photo done','1 photo'];
  if(t<5.5)return ['Belt: to Station 2',''];
  if(t<R1)return ['Lifting part onto turntable',''];
  var s=stopInfo(t);
  if(s){var n='stop '+(s.k+1)+' of 8';
    if(s.k>0&&s.u<0.5)return ['Turning 45°',n];
    if(s.u<0.65)return ['Waiting until still',n];
    if(s.r===0){ if(s.u<OFF[5]+LON)return ['Table still, taking photos',n]; return ['Stop '+(s.k+1)+' done','4 photos']; }
    if(s.u<OFF2[5]+LON)return ['Table still, CAM 5 only',n];
    return ['Stop '+(s.k+1)+' done','1 photo, CAM 5'];}
  if(t<20.3)return ['Lowering part',''];
  if(t<22.1)return ['Belt: to flip unit',''];
  if(t<24.3)return ['Turning part over','B side up next'];
  if(t<26.1)return ['Belt: back to Station 2','B side up'];
  if(t<R2)return ['Lifting part onto turntable','B side up'];
  if(t<DOWN2)return ['Lowering part',''];
  if(t<AT1)return ['Belt: to Station 1',''];
  if(t<CAP1B)return ['Part at Station 1','waiting until still'];
  if(t<ANA0)return ['Station 1 photo done','all 42 photos taken'];
  if(t<OUT0)return ['Waiting for the result','from the vision PC'];
  if(t<OUT1)return ['Sending part to '+res+' lane',''];
  return ['Ready for the next part',''];
}

/* ---------------- monitor tiles ---------------- */
function tileImg(c,r){
  if(c===1)return r?'topB':'topA';
  if(c===5)return r?'bore':'unwash';
  return c===4?'side':'gap';
}
function updTile(c,t,allowFlash){
  var T_=TILE[c],n=count(c,t);
  if(n!==T_.last){
    if(n===0){T_.el.classList.remove('has');}
    else{
      var e=lastDone(c,t),key=tileImg(c,e.r);
      if(T_.src!==key&&IMG[key]){T_.img.src=IMG[key];T_.src=key;}
      var fl=(c>=2&&c<=4)&&e.r===1;
      if(T_.flip!==fl){T_.img.classList.toggle('flipY',fl);T_.flip=fl;}
      T_.img.alt='Last photo from CAM '+c+(e.r?', B side up':', A side up');
      T_.el.classList.add('has');
      if(allowFlash&&n===T_.last+1&&!reduce){T_.flash.classList.remove('go');void T_.flash.offsetWidth;T_.flash.classList.add('go');}
    }
    T_.cnt.textContent=n+' of '+PERCAM[c];
    T_.last=n;
  }
  var li=lightI(c,t),ex=expo(c,t),xs=xferState(c,t),st;
  var offB=c>=2&&c<=4&&t>=23.15&&t<ANA0;
  if(ex)st='exp';else if(li>0)st='light';else if(xs===1)st='send';else if(offB)st='off';else if(n>0)st='saved';else st='ready';
  if(st!==T_.st){T_.st=st;T_.stat.dataset.s=st;T_.stat.textContent={exp:'Taking photo',light:'Light on',send:'Sending',saved:'Saved',ready:'Ready',off:'Off, B side up'}[st];}
  if(T_.offB!==(st==='off')){T_.offB=(st==='off');T_.el.classList.toggle('offB',T_.offB);}
  var live=(st==='exp'||st==='light');
  if(live!==T_.live){T_.live=live;T_.el.classList.toggle('live',live);}
  PORT[c].style.opacity=xs===2?1:0;
}

/* ---------------- timing strip ---------------- */
var SC={x0:128,x1:1092,win:5,past:3.5};
var LANEY={1:34,2:62,3:90,4:118,5:146};
function drawScope(t){
  var pps=(SC.x1-SC.x0)/SC.win,a=t-SC.past,b=a+SC.win;
  function X(v){return (SC.x0+(v-a)*pps).toFixed(1);}
  var h='',s,i,m,c,e,w;
  for(s=Math.ceil(a*2)/2;s<=b;s+=0.5){h+='<line class="sg'+(Math.abs(s-Math.round(s))<1e-6?' sgm':'')+'" x1="'+X(s)+'" y1="6" x2="'+X(s)+'" y2="170"/>';}
  for(i=0;i<MOTION.length;i++){m=MOTION[i];if(m[1]<a||m[0]>b)continue;w=(m[1]-m[0])*pps;
    h+='<rect class="'+(m[3]?'mvs':'mv')+'" x="'+X(m[0])+'" y="9" width="'+w.toFixed(1)+'" height="18" rx="2"/>';
    if(!m[3]&&w>46)h+='<text class="mvt" x="'+X((m[0]+m[1])/2)+'" y="22" text-anchor="middle">'+m[2]+'</text>';}
  for(c=1;c<=5;c++){for(i=0;i<EV[c].length;i++){e=EV[c][i];if(e.t+LON<a||e.t>b)continue;
    h+='<rect class="li" x="'+X(e.t)+'" y="'+(LANEY[c]+3)+'" width="'+(LON*pps).toFixed(1)+'" height="18" rx="2"/>';
    h+='<rect class="ex" x="'+X(e.t+EXA)+'" y="'+(LANEY[c]+7)+'" width="'+((EXB-EXA)*pps).toFixed(1)+'" height="10" rx="1.5"/>';}}
  var ph=X(t);
  h+='<rect class="past" x="'+SC.x0+'" y="6" width="'+(SC.past*pps).toFixed(1)+'" height="164"/>';
  h+='<line class="ph" x1="'+ph+'" y1="2" x2="'+ph+'" y2="174"/><text class="pht" x="'+ph+'" y="186" text-anchor="middle">now</text>';
  scDyn.innerHTML=h;
}

/* keep the active station in view when the machine drawing is wider than the screen */
var stageBox=document.querySelector('.stagebox');
var STEPX=[215,215,650,1070,650,215,330];
function followStation(st){
  if(!stageBox||stageBox.scrollWidth<=stageBox.clientWidth+4)return;
  var sv=$('stage'),k=sv.getBoundingClientRect().width/1200;
  var target=STEPX[st]*k-stageBox.clientWidth/2;
  target=clamp(target,0,stageBox.scrollWidth-stageBox.clientWidth);
  try{stageBox.scrollTo({left:target,behavior:reduce?'auto':'smooth'});}catch(e){stageBox.scrollLeft=target;}
}
/* ---------------- render ---------------- */
var t=0,loop=0,playing=!reduce,speed=1,last=null,lastX=null,dir=1,lastStep=-1,visible=true,dirty=true;
function render(allowFlash){
  var res=RESULTS[loop%3];
  var x=px(t),l=lift(t),fl=flipLift(t),s=sy(t);
  var o=t>=OUT0?seg(t,OUT0,OUT1):0;
  var cx=lerp(x,BINX[res[0]],o),cy=lerp(Y0-l-fl,534,o),sc=lerp(1,0.42,o);
  part.setAttribute('transform','translate('+cx.toFixed(1)+' '+cy.toFixed(1)+') scale('+sc.toFixed(3)+' '+(sc*s).toFixed(3)+')');
  var py=452-l; plate.setAttribute('y',py.toFixed(1)); shaft.setAttribute('y',(py+8).toFixed(1)); shaft.setAttribute('height',(482-py-8).toFixed(1));

  // belt
  var moving=lastX!==null&&Math.abs(x-lastX)>0.01&&o===0;
  if(moving)dir=x>lastX?1:-1;
  lastX=x;
  var off=((x%40)+40)%40;
  chevR.setAttribute('transform','translate('+off.toFixed(1)+' 0)');chevL.setAttribute('transform','translate('+off.toFixed(1)+' 0)');
  chevR.style.opacity=dir>0?(moving?1:.35):0; chevL.style.opacity=dir<0?(moving?1:.35):0;

  // flip unit
  jaws.style.opacity=(t>=21.9&&t<24.5)?1:0;
  jawL.setAttribute('y',(cy-12).toFixed(1));jawR.setAttribute('y',(cy-12).toFixed(1));
  flipArc.style.opacity=(t>=22.6&&t<23.7)?1:.3;

  // turntable seen from above
  var onTT=Math.abs(x-S2X)<1&&l>1&&o===0;
  insetImp.style.opacity=onTT?1:.15;
  insetRot.setAttribute('transform','rotate('+angle(t).toFixed(1)+' 470 160)');
  insetFlip.setAttribute('transform',sy(t)<0?'translate(940 0) scale(-1 1)':'');

  // lights and cameras
  var atS1=Math.abs(x-S1X)<1&&o===0&&((t>=2&&t<3.3)||(t>=AT1&&t<OUT0));
  var atS2=onTT&&l>=LIFT-0.5;
  var maxI=0;
  for(var c=1;c<=5;c++){
    var li=lightI(c,t),ex=expo(c,t);
    for(var j=0;j<LG[c].length;j++)setVar(LG[c][j],li);
    if(MK[c])setVar(MK[c],li);
    var active=c===1?atS1:(c===5?atS2:(atS2&&t<23.15));
    FOV[c].style.fillOpacity=ex?.32:(active?.07:.025);
    FOV[c].style.strokeOpacity=ex?.95:(active?.45:.16);
    BDG[c].classList.toggle('on',ex);
    if((c===1&&atS1)||(c>1&&atS2))maxI=Math.max(maxI,li);
    updTile(c,t,allowFlash);
  }
  partLit.style.opacity=(maxI*0.9).toFixed(3);

  // bins
  for(var k in BIN){BIN[k].style.opacity=(k===res[0]&&t>=OUT1-0.2)?(0.22+0.12*Math.sin((t-OUT1)*5)).toFixed(3):0;}

  // HUD
  var total=0;for(c=1;c<=5;c++)total+=count(c,t);
  setText(hudPhotos,'hp','Photos: '+total+' of '+TOTAL);
  var si=stopInfo(t);
  setText(hudStop,'hs',si?('Turntable: stop '+(si.k+1)+' of 8'):(onTT?'Turntable: lifted':'Turntable: idle'));
  var r2=t>=23.15;
  setText(hudRound,'hr',t>=ANA0?'Result':(r2?'Round 2: B side up':'Round 1: A side up'));
  hudRound.classList.toggle('rB',r2&&t<ANA0);

  // controller and PC
  var cs=ctlState(t,res[0]);
  setText(ctlA,'ca',cs[0]);setText(ctlB,'cb',cs[1]);
  if(t<ANA0){setText(pcA,'pa',total?('Saved '+total+' of '+TOTAL+' photos'):'Waiting for photos');setText(pcB,'pb','Original photos are saved first');pcBar0.style.opacity=0;pcBar.setAttribute('width',0);pcA.style.fill='';}
  else if(t<OUT0){setText(pcA,'pa','Checking '+TOTAL+' photos');setText(pcB,'pb','');pcBar0.style.opacity=1;pcBar.setAttribute('width',(260*clamp((t-ANA0)/(OUT0-ANA0),0,1)).toFixed(1));pcA.style.fill='';}
  else{setText(pcA,'pa','Result: '+res[0]);setText(pcB,'pb',res[0]==='REVIEW'?'a person checks the part':'saved with the part number');pcBar0.style.opacity=0;pcBar.setAttribute('width',0);
    pcA.style.fill=res[0]==='PASS'?'#5BC08A':res[0]==='FAIL'?'#F0766B':'#E2A94B';}

  drawScope(t);

  // caption
  var st=stepOf(t);
  if(st!==lastStep){
    lastStep=st;
    stepBtns.forEach(function(b,i){b.classList.toggle('on',i===st);if(i===st)b.setAttribute('aria-current','step');else b.removeAttribute('aria-current');});
    capN.textContent=String(st+1);
    followStation(st);
    cap.textContent=st<6?CAPS[st]:'All 42 photos are checked against the quality rules. This time the result is '+res[0]+': '+res[1]+'.';
  }
}
function frame(ts){
  if(last===null)last=ts;
  var dt=Math.min(0.1,(ts-last)/1000);last=ts;
  if(playing&&visible){t+=dt*speed;dirty=true;if(t>=T){t=0;loop++;lastStep=-1;lastX=null;}}
  if(dirty){render(playing);dirty=false;}
  requestAnimationFrame(frame);
}
function setPlay(p){playing=p;playBtn.textContent=p?'Pause':'Play';}
playBtn.addEventListener('click',function(){setPlay(!playing);});
restartBtn.addEventListener('click',function(){t=0;lastStep=-1;lastX=null;dirty=true;setPlay(true);});
stepBtns.forEach(function(b,i){b.addEventListener('click',function(){t=STEPS[i]+0.01;lastStep=-1;lastX=null;dirty=true;render(false);});});
speedBtns.forEach(function(b){b.addEventListener('click',function(){speed=parseFloat(b.dataset.speed);speedBtns.forEach(function(o){o.setAttribute('aria-pressed',o===b?'true':'false');});});});
if('IntersectionObserver' in window){new IntersectionObserver(function(en){visible=en[0].isIntersecting;last=null;},{threshold:0.05}).observe($('machine'));}
if(reduce){t=R1+OFF[3]+0.08;}
setPlay(playing);
render(false);
requestAnimationFrame(frame);

