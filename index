<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>How the five-camera machine checks an impeller</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" rel="stylesheet">
<style>
:root{
  --alu:#E2E6E9; --sheet:#F8F9FA; --well:#ECEFF2; --ink:#18222A; --ink2:#4E5D68; --line:#C3CCD3; --hw:#B8C3CB;
  --cam:#1F5FCF; --led:#E2A800; --ledsoft:#F7D867;
  --pass:#22744A; --fail:#B3261E; --review:#9A5F06;
  --font:"Archivo","Helvetica Neue",Arial,sans-serif;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --alu:#0F161C; --sheet:#151F27; --well:#1A2630; --ink:#E2E9EE; --ink2:#9CAEBB; --line:#2B3A46; --hw:#34474F;
    --cam:#79A8FF; --led:#F4C640; --ledsoft:#8A6E1A;
    --pass:#63C48B; --fail:#F27B71; --review:#E6AF56; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --alu:#0F161C; --sheet:#151F27; --well:#1A2630; --ink:#E2E9EE; --ink2:#9CAEBB; --line:#2B3A46; --hw:#34474F;
  --cam:#79A8FF; --led:#F4C640; --ledsoft:#8A6E1A;
  --pass:#63C48B; --fail:#F27B71; --review:#E6AF56; color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px);-webkit-text-size-adjust:100%}
body{margin:0;background:var(--alu);color:var(--ink);font-family:var(--font);font-size:18px;line-height:1.55}
img{max-width:100%;height:auto;display:block}
a{color:var(--cam)}
button{font-family:inherit}
:focus-visible{outline:3px solid var(--cam);outline-offset:2px}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}

/* ---------- header ---------- */
.topline{display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px 20px;padding:22px 0 0;font-size:.95rem;color:var(--ink2)}
h1{font-size:clamp(2.3rem,5.4vw,4.2rem);font-weight:780;font-stretch:70%;line-height:.97;letter-spacing:-.005em;margin:28px 0 16px;max-width:17ch}
.lead{font-size:1.2rem;max-width:60ch;margin:0 0 28px}
h2{font-size:clamp(1.75rem,3.3vw,2.4rem);font-weight:750;font-stretch:76%;line-height:1.04;margin:0 0 12px}
h3{font-size:1.3rem;font-weight:700;font-stretch:84%;line-height:1.2;margin:0 0 6px}
section{padding:64px 0 0}
p{margin:0 0 12px;max-width:66ch}
.note{font-size:.95rem;color:var(--ink2)}
.scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}

/* ---------- the machine (dark enclosure) ---------- */
.encl{background:#16202A;border-radius:20px;color:#D3DCE3;overflow:hidden;box-shadow:0 0 0 1px #0E151B}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .encl{background:#0B1116;box-shadow:0 0 0 1px #24323D}}
:root[data-theme="dark"] .encl{background:#0B1116;box-shadow:0 0 0 1px #24323D}
.hud{display:flex;flex-wrap:wrap;gap:8px 10px;align-items:center;padding:14px 16px 4px}
.tag{font-weight:650;font-stretch:82%;font-size:1rem;padding:3px 12px;border-radius:6px;border:1.5px solid #34444F;color:#E3EAF0;font-variant-numeric:tabular-nums;white-space:nowrap}
.tag.rB{border-style:dashed}
.keys{display:flex;gap:14px;align-items:center;font-size:.9rem;color:#9FB1BE;margin-left:6px}
.keys i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.keys .kL{background:#FFE07A} .keys .kC{background:#4D8DFF}
.speed{margin-left:auto;display:inline-flex;border:1.5px solid #34444F;border-radius:8px;overflow:hidden}
.speed button{background:transparent;color:#B7C6D1;border:0;padding:5px 12px;font-size:.92rem;font-weight:600;font-stretch:85%;cursor:pointer}
.speed button[aria-pressed="true"]{background:#2B3A46;color:#fff}
.stagebox{overflow-x:auto;-webkit-overflow-scrolling:touch}
#stage{display:block;width:100%;min-width:740px;height:auto;font-family:var(--font);--cBody:#5D707F;--cLens:#93A6B4}
#stage .sT{fill:#E3EAF0;font-size:21px;font-weight:720;font-stretch:80%}
#stage .sS{fill:#8EA1AF;font-size:14.5px;font-weight:500}
#stage .sA{fill:#C9D5DE;font-size:14.5px;font-weight:680;font-stretch:85%}
#stage .frm{fill:#1C2731;stroke:#2D3C48;stroke-width:1.5}
#stage .belt{fill:#2E3C47} #stage .roll{fill:#17212A;stroke:#4C5E6C;stroke-width:2}
#stage .chev{fill:none;stroke:#6D8090;stroke-width:2}
#stage .hw{fill:#34444F} #stage .hw2{fill:#5A6E7C}
#stage .fov{fill:#4D8DFF;stroke:#4D8DFF;stroke-width:1.2;stroke-dasharray:5 4;fill-opacity:.03;stroke-opacity:.2}
#stage .lamp{fill:#26333D;stroke:#4E6170;stroke-width:1}
#stage .lampS{fill:none;stroke:#2A3742;stroke-width:9;stroke-linecap:round}
#stage .ledoff{stroke:#56646F;stroke-width:3;stroke-linecap:round;fill:none}
#stage .ledon{stroke:#FFFCEE;stroke-width:3.6;stroke-linecap:round;fill:none;opacity:var(--i,0)}
#stage .beam{opacity:calc(var(--i,0) * .85)}
#stage .halo{opacity:var(--i,0)}
#stage .bdg circle{fill:#0F171E;stroke:#8DA0AE;stroke-width:1.5}
#stage .bdg .bring{fill:none;stroke:#4D8DFF;stroke-width:3;opacity:0}
#stage .bdg text{fill:#E3EAF0;font-size:13px;font-weight:750}
#stage .bdg.on circle.bc{fill:#3E7BFF;stroke:#D5E3FF}
#stage .bdg.on .bring{opacity:.55}
#stage .pnl{fill:#1C2731;stroke:#2D3C48;stroke-width:1.5}
#stage .pT{fill:#8EA1AF;font-size:14px;font-weight:600}
#stage .pV{fill:#E8EEF2;font-size:18px;font-weight:650;font-stretch:84%}
#stage .pS{fill:#8EA1AF;font-size:13.5px}
#stage .bin{fill:none;stroke-width:2}
#stage .binG{opacity:0}
#stage .bP{stroke:#5BC08A} #stage .bR{stroke:#E2A94B} #stage .bF{stroke:#F0766B}
#stage .gP{fill:#5BC08A} #stage .gR{fill:#E2A94B} #stage .gF{fill:#F0766B}
#stage .tP{fill:#5BC08A} #stage .tR{fill:#E2A94B} #stage .tF{fill:#F0766B}
#stage .binT{font-size:14px;font-weight:750;font-stretch:85%}
#stage .port{fill:#26333D;stroke:#4E6170}
#stage .porton{fill:#4D8DFF;opacity:0}
#stage .portT{fill:#8EA1AF;font-size:10.5px;font-weight:700}
#stage .bar0{fill:#26333D} #stage .bar1{fill:#4D8DFF}
#stage .insetbg{fill:#121A21;stroke:#3A4B58;stroke-width:1.5}
#stage .mk circle.mc{fill:#0F171E;stroke:#8DA0AE;stroke-width:1.4}
#stage .mk .mkg{fill:#FFE9A8;opacity:var(--i,0)}
#stage .mk text{fill:#E3EAF0;font-size:12px;font-weight:750}
#stage .mk line{stroke:#5F7382;stroke-width:1.5;stroke-dasharray:2 3}
#stage .jaw{fill:#8EA1AF}
#stage .ringE{fill:none;stroke:#4E6170;stroke-width:1.5}
#stage .rot{fill:none;stroke:#8EA1AF;stroke-width:2}
#stage .arw{fill:#8EA1AF}

/* capture monitor */
.monitor{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;padding:6px 16px 12px}
.tile{margin:0;background:#0E151B;border:1.5px solid #2B3945;border-radius:10px;overflow:hidden;transition:border-color .2s}
.tile.live{border-color:#4D8DFF}
.tframe{position:relative;aspect-ratio:4/3;background:#06090C;overflow:hidden}
.tframe img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .15s}
.tile.has .tframe img{opacity:1}
.tframe img.cropL{transform:scale(1.75);transform-origin:6% 58%}
.tframe img.cropR{transform:scale(1.75);transform-origin:94% 58%}
.tframe img.contain{object-fit:contain;padding:8%}
.tframe img.flipY{transform:scaleY(-1)}
.tframe img.cropL.flipY{transform:scale(1.75,-1.75)}
.tframe img.cropR.flipY{transform:scale(1.75,-1.75)}
.tempty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:8px;font-size:.82rem;color:#6F8291}
.tile.has .tempty{display:none}
.tflash{position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none}
.tflash.go{animation:tflash .42s ease-out}
@keyframes tflash{from{opacity:.55}to{opacity:0}}
.tile figcaption{padding:7px 9px 8px;font-size:.85rem;line-height:1.3}
.tile figcaption b{font-weight:750;font-stretch:85%;font-size:.98rem;color:#E8EEF2;margin-right:6px}
.tile figcaption span{color:#9FB1BE}
.tmeta{display:flex;justify-content:space-between;gap:6px;margin-top:5px;align-items:center}
.tstat{font-weight:650;font-stretch:85%;padding:1px 7px;border-radius:4px;background:#1E2A35;color:#9FB1BE;font-size:.8rem}
.tstat[data-s="light"]{background:#FFE07A;color:#2A2100}
.tstat[data-s="exp"]{background:#4D8DFF;color:#fff}
.tstat[data-s="send"]{background:#1E2A35;color:#9CC0FF}
.tstat[data-s="saved"]{color:#C9D5DE}
.tstat[data-s="off"]{background:transparent;color:#7F92A0;box-shadow:inset 0 0 0 1px #34444F}
.tile.offB .tframe img{opacity:.35}
.tcnt{color:#8EA1AF;font-variant-numeric:tabular-nums;font-size:.8rem}

/* scope */
.scope{padding:0 16px 16px}
.scopehead{display:flex;justify-content:space-between;flex-wrap:wrap;gap:4px 12px;font-size:.88rem;color:#9FB1BE;margin:0 2px 6px}
.scopehead b{color:#E3EAF0;font-weight:650;font-stretch:85%;font-size:.98rem}
#scope{display:block;width:100%;min-width:640px;height:auto;font-family:var(--font)}
#scope .lane{fill:#121A21}
#scope .lt{fill:#AFC0CC;font-size:13.5px;font-weight:600;font-stretch:88%}
#scope .sg{stroke:#24313C;stroke-width:1} #scope .sgm{stroke:#33434F}
#scope .mv{fill:#3C4D5A} #scope .mvs{fill:url(#hatchD)}
#scope .mvt{fill:#C9D5DE;font-size:12px;font-weight:600}
#scope .li{fill:#FFE07A} #scope .ex{fill:#4D8DFF}
#scope .past{fill:#16202A;opacity:.45}
#scope .ph{stroke:#fff;stroke-width:1.5}
#scope .pht{fill:#fff;font-size:12px;font-weight:700}

/* controls under the machine */
.under{padding:14px 2px 0}
.cap{display:flex;gap:12px;align-items:flex-start;max-width:none;margin:0 0 12px;font-size:1.13rem;min-height:3.4em}
.capn{flex:none;display:inline-flex;width:32px;height:32px;border-radius:50%;background:var(--ink);color:var(--sheet);align-items:center;justify-content:center;font-weight:750;font-stretch:85%;font-size:1.05rem;margin-top:1px}
.ctrl{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.btn{font-weight:700;font-stretch:85%;font-size:1.02rem;padding:7px 18px;border-radius:999px;border:2px solid var(--ink);background:var(--ink);color:var(--sheet);cursor:pointer}
.btn.ghost{background:transparent;color:var(--ink)}
.stepbar{display:flex;flex-wrap:wrap;gap:6px;margin-left:auto}
.stepbtn{font-weight:600;font-stretch:88%;font-size:.95rem;display:inline-flex;align-items:center;gap:6px;padding:4px 12px 4px 5px;border-radius:999px;border:1.5px solid var(--line);background:var(--sheet);color:var(--ink);cursor:pointer}
.stepbtn span{display:inline-flex;width:22px;height:22px;border-radius:50%;align-items:center;justify-content:center;background:var(--ink);color:var(--sheet);font-weight:750;font-size:.82rem}
.stepbtn.on{border-color:var(--ink);background:var(--well);box-shadow:inset 0 0 0 1px var(--ink)}

/* tables */
.tbl{width:100%;border-collapse:separate;border-spacing:0;background:var(--sheet);border:1px solid var(--line);border-radius:12px;overflow:hidden;font-size:1rem}
.tbl th,.tbl td{padding:11px 14px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}
.tbl tr:last-child td,.tbl tr:last-child th{border-bottom:none}
.tbl thead th{font-weight:700;font-stretch:84%;font-size:1.05rem;background:var(--well)}
.tbl tbody th{font-weight:700;font-stretch:84%;font-size:1.04rem;white-space:nowrap}
.tbl .new{font-weight:600}
.tbl td.off{color:var(--ink2)}
.tbl .sub{display:block;font-weight:500;font-size:.9rem;color:var(--ink2);font-stretch:100%}

/* names figures */
.two{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}
.two>*{min-width:0}
.names{grid-template-columns:1fr;max-width:860px;gap:26px}
.panel{background:var(--sheet);border:1px solid var(--line);border-radius:14px;padding:14px}
.figcap{font-size:.92rem;color:var(--ink2);margin-top:8px}
.dg{display:block;width:100%;height:auto;font-family:var(--font);--cBody:var(--ink);--cLens:var(--ink2)}
.dg .tl{fill:var(--ink);font-size:26px;font-weight:700;font-stretch:85%}
.dg .ts{fill:var(--ink2);font-size:20px}
.dg .dot{fill:var(--cam);stroke:#fff;stroke-width:2}
.dg .ldr{stroke:var(--ink2);stroke-width:1.4;fill:none}

/* camera explorer */
.extabs{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 14px}
.extab{display:inline-flex;align-items:center;gap:8px;padding:6px 14px 6px 6px;border-radius:10px;border:1.5px solid var(--line);background:var(--sheet);color:var(--ink);cursor:pointer;font-size:.98rem;font-weight:600;font-stretch:88%;text-align:left;line-height:1.2}
.extab b{display:inline-flex;width:28px;height:28px;border-radius:7px;align-items:center;justify-content:center;background:var(--ink);color:var(--sheet);font-weight:750}
.extab small{display:block;font-weight:500;color:var(--ink2);font-size:.85rem}
.extab[aria-selected="true"]{border-color:var(--cam);box-shadow:inset 0 0 0 1px var(--cam);background:var(--well)}
.extab[aria-selected="true"] b{background:var(--cam);color:#fff}
.exgrid{display:grid;grid-template-columns:1.55fr 1fr;gap:14px}
.exgrid>*{min-width:0}
.dgbox{background:var(--sheet);border:1px solid var(--line);border-radius:14px;padding:10px}
.dgbox .lbl{font-size:.88rem;color:var(--ink2);margin:2px 4px 4px;font-weight:600}
.ex .cg{opacity:.18;transition:opacity .25s}
.ex .cg.on{opacity:1}
.ex .onl{opacity:0;transition:opacity .25s} .ex .cg.on .onl{opacity:1}
.ex .xbeam{opacity:0;transition:opacity .25s} .ex .cg.on .xbeam{opacity:1}
.ex .xfov{fill:var(--cam);fill-opacity:.08;stroke:var(--cam);stroke-width:1.4;stroke-dasharray:5 4}
.ex .cg.on .xfov{fill-opacity:.16}
.ex .xlamp{fill:var(--ink2)} .ex .xlampS{fill:none;stroke:var(--ink2);stroke-width:8;stroke-linecap:round}
.ex .xled{stroke:var(--line);stroke-width:2.6;fill:none;stroke-linecap:round}
.ex .cg.on .xled{stroke:var(--led)}
.ex .xbdg circle{fill:var(--ink)} .ex .xbdg text{fill:var(--sheet);font-size:14px;font-weight:750}
.ex .cg.on .xbdg circle{fill:var(--cam)} .ex .cg.on .xbdg text{fill:#fff}
.ex .xl{fill:var(--ink);font-size:17px;font-weight:720;font-stretch:84%}
.ex .xs{fill:var(--ink2);font-size:14px}
.ex .xa{fill:var(--ink);font-size:14px;font-weight:700}
.ex .arc{fill:none;stroke:var(--ink);stroke-width:1.4}
.ex .ref{stroke:var(--ink2);stroke-width:1.2;stroke-dasharray:3 4;fill:none}
.ex .xhw{fill:var(--hw)} .ex .xbelt{fill:var(--well);stroke:var(--line)}
.ex .ttc{fill:none;stroke:var(--ink2);stroke-width:1.4;stroke-dasharray:4 5}
.ex .ring5{fill:none;stroke:var(--ink2);stroke-width:18;opacity:.35}
.ex .cg.on .ring5{stroke:var(--led);opacity:.45}
.exd{display:grid;grid-template-columns:1.1fr 1fr;gap:18px;margin-top:14px;background:var(--sheet);border:1px solid var(--line);border-radius:14px;padding:18px}
.exd>*{min-width:0}
.exd dl{margin:8px 0 0;display:grid;grid-template-columns:auto 1fr;gap:6px 16px;font-size:1rem}
.exd dt{font-weight:650;font-stretch:85%;color:var(--ink2)}
.exd dd{margin:0}
.exph{position:relative;border-radius:10px;overflow:hidden;background:#000;aspect-ratio:4/3}
.exph img{width:100%;height:100%;object-fit:cover}
.exph img.cropL{transform:scale(1.6);transform-origin:6% 58%}
.exph img.cropR{transform:scale(1.6);transform-origin:94% 58%}
.exph img.contain{object-fit:contain;background:#fff;padding:6%}
.excap{font-size:.92rem;color:var(--ink2);margin:8px 0 0}
.exsmall{display:grid;grid-template-columns:120px 1fr;gap:10px;align-items:center;margin-top:10px;font-size:.92rem;color:var(--ink2)}
.exsmall img{border-radius:8px;aspect-ratio:4/3;object-fit:cover}
.exsmall[hidden]{display:none}

/* lights */
.lights{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:16px}
.lightcard{margin:0;background:var(--sheet);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.lightcard img{width:100%;aspect-ratio:16/10;object-fit:cover}
.lightcard div{padding:14px 16px 16px}
.lightcard h3{margin-bottom:2px}
.lightcard .for{font-size:.95rem;color:var(--ink2);margin:0 0 8px}
.lightcard p{font-size:1rem;margin:0}

/* every stop diagram */
.legend{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:.95rem;color:var(--ink2);margin:12px 0 10px}
.legend i{display:inline-block;width:14px;height:14px;border-radius:3px;margin-right:6px;vertical-align:-2px}
.legend .kL{background:var(--ledsoft);box-shadow:inset 0 0 0 1.5px var(--led)} .legend .kC{background:var(--cam)} .legend .kM{background:var(--hw)} .legend .kS{background:repeating-linear-gradient(45deg,var(--hw) 0 3px,transparent 3px 6px);box-shadow:inset 0 0 0 1px var(--ink2)}
.stopdg{min-width:760px}
.stopdg .lane{fill:var(--well)}
.stopdg .ln{fill:var(--ink);font-size:16px;font-weight:700;font-stretch:85%}
.stopdg .lns{fill:var(--ink2);font-size:13.5px}
.stopdg .mv{fill:var(--hw)} .stopdg .mvs{fill:url(#hatchL)} .stopdg .still{fill:none;stroke:var(--ink2);stroke-width:1.2;stroke-dasharray:4 4}
.stopdg .mvt{fill:var(--ink);font-size:14px;font-weight:600}
.stopdg .li{fill:var(--ledsoft);stroke:var(--led);stroke-width:1.5}
.stopdg .ex{fill:var(--cam)}
.stopdg .xf{fill:var(--cam);fill-opacity:.14;stroke:var(--cam);stroke-width:1.3}
.stopdg .xft{fill:var(--cam);font-size:12px;font-weight:700}
.stopdg .trg{fill:none;stroke:var(--ink);stroke-width:2}
.stopdg .trgt{fill:var(--ink);font-size:12.5px;font-weight:700}
.stopdg .tick{stroke:var(--ink2);stroke-width:1.2}
.stopdg .tt{fill:var(--ink2);font-size:13px}
.stopdg .zl{fill:var(--ink);font-size:14px;font-weight:600}
.stopdg .zn{fill:var(--ink);font-size:12px;font-weight:750}
.stopdg .zc{fill:var(--sheet);stroke:var(--ink);stroke-width:1.4}
.stopdg .con{stroke:var(--ink2);stroke-width:1;stroke-dasharray:3 3;fill:none}
.stopdg .zh{fill:var(--ink);font-size:15px;font-weight:700;font-stretch:85%}
.rules{margin:14px 0 0;padding-left:1.2rem;max-width:72ch}
.rules li{margin:0 0 8px}

/* pipeline */
.pipe{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:16px}
.pipe>div{background:var(--sheet);border:1px solid var(--line);border-radius:14px;padding:16px 16px 6px}
.pipe h3{display:flex;align-items:center;gap:10px}
.pipe h3 em{font-style:normal;font-size:.8rem;font-weight:650;color:var(--ink2);font-stretch:90%}
.pipe ol{list-style:none;margin:10px 0 0;padding:0;counter-reset:none}
.pipe li{display:grid;grid-template-columns:30px 1fr;gap:10px;margin:0 0 12px;font-size:1rem;line-height:1.45}
.pipe li .n{width:28px;height:28px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;border:1.5px solid var(--ink);font-weight:750;font-size:.86rem;font-stretch:85%}
.pipe li b{display:block;font-weight:700;font-stretch:86%;font-size:1.04rem}
.pipe .g1{border-top:5px solid var(--ink)} .pipe .g2{border-top:5px solid var(--cam)} .pipe .g3{border-top:5px solid var(--pass)}

/* results */
.res{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px}
.res>div{background:var(--sheet);border:1px solid var(--line);border-radius:14px;padding:16px;border-top-width:6px}
.res .p{border-top-color:var(--pass)} .res .f{border-top-color:var(--fail)} .res .r{border-top-color:var(--review)}
.res .word{font-weight:780;font-stretch:80%;font-size:1.6rem;display:block;line-height:1.1;margin-bottom:4px}
.res .p .word{color:var(--pass)} .res .f .word{color:var(--fail)} .res .r .word{color:var(--review)}
.res p{margin:0;font-size:1rem}
.who{margin-top:16px;background:var(--sheet);border:1px solid var(--line);border-left:6px solid var(--ink);border-radius:10px;padding:14px 16px}
.who p{margin:0;max-width:none}
ul.simple{margin:8px 0 0;padding-left:1.2rem;max-width:66ch}
ul.simple li{margin:0 0 6px}
.example{display:grid;grid-template-columns:1.2fr 1fr;gap:18px;align-items:center;margin-top:18px}
.example img{border-radius:10px}
.example .verdict{font-weight:780;font-stretch:80%;color:var(--fail);font-size:1.4rem}
ol.q{margin:12px 0 0;padding-left:1.4rem;max-width:72ch}
ol.q li{margin:0 0 10px;padding-left:4px}
details{margin-top:16px;background:var(--sheet);border:1px solid var(--line);border-radius:12px;padding:12px 16px}
summary{cursor:pointer;font-weight:700;font-stretch:85%;font-size:1.15rem}
details ul{margin:10px 0 4px;padding-left:1.2rem;font-size:1rem}
details li{margin:0 0 7px}
footer{padding:48px 0 56px;color:var(--ink2);font-size:.9rem}

@media (max-width:980px){
  .monitor{grid-template-columns:repeat(3,minmax(0,1fr))}
  .exgrid,.exd{grid-template-columns:1fr}
  .pipe{grid-template-columns:1fr}
}
@media (max-width:760px){
  .two,.example,.res,.lights{grid-template-columns:1fr}
  .stepbar{margin-left:0}
  .cap{font-size:1.02rem}
  .speed{margin-left:0}
}
@media (max-width:560px){
  body{font-size:17px}
  .wrap{padding:0 14px}
  .monitor{grid-template-columns:repeat(2,minmax(0,1fr))}
  .exd dl{grid-template-columns:1fr}
  .exd dt{margin-top:4px}
}
@media (prefers-reduced-motion: reduce){
  .tflash.go{animation:none}
  .ex .cg,.ex .onl,.ex .xbeam,.tile{transition:none}
}
.tstat,.tcnt{font-style:normal}
.ex .cg.only{opacity:0} .ex .cg.only.on{opacity:1}
</style>
