  if(t<20.3)return S2X;
  if(t<22.1)return lerp(S2X,FLX,seg(t,20.3,22.1));
  if(t<24.3)return FLX;
  if(t<26.1)return lerp(FLX,S2X,seg(t,24.3,26.1));
  if(t<DOWN2)return S2X;
  if(t<AT1)return lerp(S2X,S1X,seg(t,DOWN2,AT1));
  return S1X;
}
function lift(t){
  if(t<5.5)return 0; if(t<6.1)return LIFT*seg(t,5.5,6.1); if(t<19.7)return LIFT; if(t<20.3)return LIFT*(1-seg(t,19.7,20.3));
  if(t<26.1)return 0; if(t<26.7)return LIFT*seg(t,26.1,26.7); if(t<R2END)return LIFT; if(t<DOWN2)return LIFT*(1-seg(t,R2END,DOWN2));
  return 0;
}
function flipLift(t){if(t<22.1||t>=24.3)return 0;if(t<22.6)return 50*seg(t,22.1,22.6);if(t<23.7)return 50;return 50*(1-seg(t,23.7,24.3));}
function sy(t){if(t<22.6)return 1;if(t<23.7)return Math.cos(Math.PI*seg(t,22.6,23.7));return -1;}
function stopInfo(t){
  if(t>=R1&&t<R1+8*STOP){var k=Math.floor((t-R1)/STOP);return {r:0,k:k,u:t-R1-k*STOP};}
  if(t>=R2&&t<R2END){var k2=Math.floor((t-R2)/STOP2);return {r:1,k:k2,u:t-R2-k2*STOP2};}
  return null;
}
function angle(t){
  var s=stopInfo(t);
  if(!s){ if(t<R1)return 0; if(t>=R2END)return 675; return t<R2-1?315:360; }
  var base=s.r?360:0;
  if(s.k>0&&s.u<0.5)return base+45*(s.k-1)+45*ease(s.u/0.5);
  return base+45*s.k;
}
function evAt(c,t){var a=EV[c];for(var i=a.length-1;i>=0;i--){if(a[i].t<=t)return a[i];}return null;}
function lightI(c,t){var e=evAt(c,t);if(!e)return 0;var d=t-e.t;if(d>LON)return 0;return Math.max(0,Math.min(1,d/0.012,(LON-d)/0.02));}
function expo(c,t){var e=evAt(c,t);if(!e)return false;var d=t-e.t;return d>=EXA&&d<EXB;}
function count(c,t){var n=0,a=EV[c];for(var i=0;i<a.length;i++)if(t>=a[i].t+EXB)n++;return n;}
function lastDone(c,t){var r=null,a=EV[c];for(var i=0;i<a.length;i++)if(t>=a[i].t+EXB)r=a[i];return r;}
function xferState(c,t){var e=lastDone(c,t);if(!e)return 0;var d=t-(e.t+EXB);return d<XFER?1:(d<XFER+0.22?2:0);}
function stepOf(t){var s=0;for(var i=0;i<STEPS.length;i++)if(t>=STEPS[i])s=i;return s;}
function activeCam(t){for(var c=1;c<=5;c++){var e=evAt(c,t);if(e&&t-e.t<LON+0.06)return c;}return 0;}

/* ---------------- elements ---------------- */
var part=$('part'),partLit=$('partLit'),plate=$('ttPlate'),shaft=$('ttShaft'),jaws=$('jaws'),jawL=$('jawL'),jawR=$('jawR'),flipArc=$('flipArc');
